# Template for secrets.env (which is gitignored). Copy to secrets.env and fill in.
# Imported by application.properties via spring.config.import.
spring.datasource.url=jdbc:postgresql://localhost:5432/task_api
spring.datasource.username=
spring.datasource.password=
# 256-bit base64-encoded secret for HMAC-SHA256 JWT signing (generate with: openssl rand -base64 32)
app.jwt.secret=

# SMTP settings for OTP email delivery
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=
spring.mail.password=
app.mail.from=no-reply@managable.local
